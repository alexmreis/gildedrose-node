{
  "name": "gilded-rose-kata",
  "version": "1.0.0",
  "description": "Gilded Rose kata in TypeScript",
  "scripts": {
    "precompile": "rimraf app/**/*.js test/**/*.js",
    "compile": "tsc --skipLibCheck --outDir dist",
    "pretest": "rimraf app/**/*.js test/**/*.js",
    "test:jest": "jest",
    "test:jest:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "format": "prettier --write app test jest.config.ts eslint.config.mjs",
    "format:check": "prettier --check app test jest.config.ts eslint.config.mjs",
    "prepare": "husky"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.4.0",
    "@types/node": "^18.14.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^29.4.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rimraf": "^4.1.2",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.1",
    "typescript": "^4.4.4",
    "typescript-eslint": "^8.72.1"
  }
}
